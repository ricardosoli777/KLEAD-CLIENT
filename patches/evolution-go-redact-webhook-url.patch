+package webhook_producer
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRedactWebhookURL(t *testing.T) {
+	tests := []struct {
+		name      string
+		rawURL    string
+		wantParts []string
+		forbidden []string
+	}{
+		{
+			name:      "redacts sensitive query values",
+			rawURL:    "https://api.example.com/webhook/instance?token=secret&code=oauth-code&state=oauth-state&event=message",
+			wantParts: []string{"token=%5Bredacted%5D", "code=%5Bredacted%5D", "state=%5Bredacted%5D", "event=message"},
+			forbidden: []string{"secret", "oauth-code", "oauth-state"},
+		},
+		{
+			name:      "redacts keys case insensitively and user info",
+			rawURL:    "https://user:password@api.example.com/webhook?Access_Token=bearer&APIKEY=key",
+			wantParts: []string{"%5Bredacted%5D@api.example.com", "Access_Token=%5Bredacted%5D", "APIKEY=%5Bredacted%5D"},
+			forbidden: []string{"user", "password", "bearer", "=key"},
+		},
+		{
+			name:      "keeps non sensitive URL unchanged",
+			rawURL:    "https://api.example.com/webhook/instance?event=message",
+			wantParts: []string{"https://api.example.com/webhook/instance?event=message"},
+		},
+		{
+			name:      "fails closed for invalid URL",
+			rawURL:    "https://api.example.com/webhook?token=%zz-secret",
+			wantParts: []string{"[invalid-url]"},
+			forbidden: []string{"secret"},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := redactWebhookURL(test.rawURL)
+			for _, want := range test.wantParts {
+				if !strings.Contains(got, want) {
+					t.Fatalf("redactWebhookURL() = %q, expected to contain %q", got, want)
+				}
+			}
+			for _, forbidden := range test.forbidden {
+				if strings.Contains(got, forbidden) {
+					t.Fatalf("redactWebhookURL() = %q, leaked %q", got, forbidden)
+				}
+			}
+		})
+	}
+}
