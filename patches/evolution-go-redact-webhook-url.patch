 func (p *webhookProducer) sendWebhookWithRetry(url string, body []byte, maxRetries int, retryInterval time.Duration, userID string) {
+	logURL := redactWebhookURL(url)
 	for i := 0; i < maxRetries; i++ {
 		err, responseBody, statusCode := p.sendWebhook(url, body, userID)
 		if err == nil {
-			p.loggerWrapper.GetLogger(userID).LogInfo("[%s] webhook sent successfully - url: %s, status: %d, response: %s", userID, url, statusCode, string(responseBody))
+			p.loggerWrapper.GetLogger(userID).LogInfo("[%s] webhook sent successfully - url: %s, status: %d, response: %s", userID, logURL, statusCode, string(responseBody))
 			return
 		}
-		p.loggerWrapper.GetLogger(userID).LogWarn("[%s] webhook failed - url: %s, attempt: %d, error: %v", userID, url, i+1, err)
+		p.loggerWrapper.GetLogger(userID).LogWarn("[%s] webhook failed - url: %s, attempt: %d, error: %v", userID, logURL, i+1, err)
 
 		time.Sleep(retryInterval)
 	}
-	p.loggerWrapper.GetLogger(userID).LogError("[%s] webhook failed after maximum retries - url: %s", userID, url)
+	p.loggerWrapper.GetLogger(userID).LogError("[%s] webhook failed after maximum retries - url: %s", userID, logURL)
+}
+
+func redactWebhookURL(rawURL string) string {
+	parsed, err := url.Parse(rawURL)
+	if err != nil {
+		return "[invalid-url]"
+	}
+
+	if parsed.User != nil {
+		parsed.User = url.User("[redacted]")
+	}
+
+	sensitiveKeys := []string{"token", "code", "state", "apikey", "api_key", "access_token"}
+	query, err := url.ParseQuery(parsed.RawQuery)
+	if err != nil {
+		return "[invalid-url]"
+	}
+	for key := range query {
+		for _, sensitiveKey := range sensitiveKeys {
+			if strings.EqualFold(key, sensitiveKey) {
+				query.Set(key, "[redacted]")
+				break
+			}
+		}
+	}
+	parsed.RawQuery = query.Encode()
+
+	return parsed.String()
 }
 
