# TEMPLATE SEM CREDENCIAIS. O wizard cria /etc/klead/klead.env na VPS.
# example.com e seus subdomínios são fictícios: use os domínios da nova instalação.
# Endereços da instalação pessoal do fornecedor não pertencem a este template.
# Nunca preencher/versionar este template com dados reais.
# Execute python install.py; não é necessário copiar este arquivo.

DOMAIN_API=api.example.com
DOMAIN_APP=app.example.com
DOMAIN_LOGIN=app.example.com
DOMAIN_PLANS=app.example.com
DOMAIN_EVO=go.example.com
DOMAIN_PORTAINER=portainer.example.com
ACME_EMAIL=
TRAEFIK_NETWORK=klead
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver

DASHBOARD_SECRET=
WEBHOOK_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
PORTAINER_ADMIN_PASSWORD=
PORTAINER_SECRET_PATH=/etc/klead/secrets/portainer_admin_password
COOKIE_SECURE=true

# Postgres: banco do app separado dos bancos do WhatsApp.
EVO_PG_HOST=postgres
EVO_PG_PORT=5432
EVO_PG_USER=postgres
EVO_PG_PASSWORD=
EVO_PG_DB=evolution_go_users
INST_PG_DB=klead
CRM_PG_DB=klead
# Derivadas pelo wizard para URLs do Evolution GO.
EVO_PG_USER_URLENCODED=
EVO_PG_PASSWORD_URLENCODED=

EVO_GLOBAL_API_KEY=
EVO_API_URL=https://go.example.com
WEBHOOK_BASE_URL=http://klead_backend:8000
PUBLIC_WEBHOOK_BASE=https://api.example.com
EVO_MEDIA_BASE=http://klead_backend:8000
KLEAD_APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com

# Integrações opcionais.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
KLEAD_LLM_PROVIDER=
KLEAD_LLM_MODEL=
EMBEDDING_OPENAI_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
META_APP_SECRET=
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
META_OAUTH_REDIRECT_URI=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LITE=
STRIPE_PRICE_USER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_LITE_MENSAL_AVULSO=
STRIPE_PRICE_LITE_SEMESTRAL=
STRIPE_PRICE_LITE_ANUAL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
QUEUE_MAX_SIZE=500
AUTO_PATTERNS_INTERVAL_HOURS=6
AUTO_PATTERNS_MIN_CONVS=5
